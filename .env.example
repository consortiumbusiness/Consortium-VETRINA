# --- Supabase (database condiviso Consortium) ------------------------------
# Le richieste dell'assessment finiscono nella tabella `richieste_consulenza`.
# URL e chiave pubblica (anon) li trovi in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sito ------------------------------------------------------------------
# URL pubblico del sito, usato per i metadata / OpenGraph.
# In locale puoi lasciarlo vuoto (default: http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://consortiumbusiness.settanta.eu
